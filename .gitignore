# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swo
*.swp

# Local caches / artifacts
cache/
reports/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Environment
.env

# DVC cache (tracked separately)
.dvc/cache/

# OS files
.DS_Store
Thumbs.db

# Large binary data (tracked by DVC)
*.parquet
*.joblib
*.pkl
*.pt
*.pth

# Data and model artifacts (keep DVC-tracked, not git)
data/raw/*.csv
data/raw/*.xlsx
models/

# Logs and temporary files
*.log
*.bak
uv.lock.bak
packages.txt

# Outputs (keep config and validation templates, ignore run registry/archive/intermediates)
outputs/archive/
outputs/run_registry/
outputs/gnn/
outputs/shap/
outputs/diagnostics/
outputs/y_randomization/
outputs/benchmark/
outputs/external_validation/
outputs/ADENO_*

# Unwanted directories
unwanted part/
